# GitLab MCP 服務器環境變數配置範本
# 複製此檔案為 .env 並填入實際值

# === 多 target 模式（建議）===
# 設了 GITLAB_TARGETS_JSON 就不用 GITLAB_URL／GITLAB_TOKEN；token 從憑證檔讀
# GITLAB_TARGETS_JSON=[{"id":"larvata","url":"https://gitlab.example.com","default":true},{"id":"larvata-new","url":"https://gitlab-new.example.com"}]
# GITLAB_CREDENTIALS_FILE=/creds.json

# === 單台相容模式 ===

# GitLab 伺服器位址 (必填)
# 範例: https://gitlab.example.com
GITLAB_URL=https://your-gitlab.example.com

# GitLab Personal Access Token (必填)
# 在 GitLab > User Settings > Access Tokens 中建立
# 建議權限範圍: api, read_user, read_repository
GITLAB_TOKEN=your_personal_access_token

# === 可選配置 ===

# 日誌級別 (DEBUG, INFO, WARNING, ERROR, CRITICAL，預設: INFO)
GITLAB_MCP_LOG_LEVEL=INFO

# API 請求逾時時間（秒，預設: 30）
GITLAB_TIMEOUT=30

# 傳輸模式 (stdio 或 sse，預設: stdio)
# GITLAB_MCP_TRANSPORT=sse

# SSE 模式綁定位址（預設: 0.0.0.0）
# GITLAB_MCP_HOST=0.0.0.0

# SSE 模式監聽埠（預設: 8000）
# GITLAB_MCP_PORT=8000
